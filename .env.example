# AttendAI Environment Configuration Example

# ----------------------------------------------------
# Backend Deployment (e.g. Render Web Service)
# ----------------------------------------------------
APP_ENV=production
PROJECT_NAME="AttendAI"

# Strong unique secret for JWT access tokens (e.g., generate with `openssl rand -hex 32`)
JWT_SECRET=attendai_super_secret_production_key_2026_x89f
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Connection String (Render PostgreSQL Database or external managed DB)
# Note: Render often supplies postgres://... which AttendAI automatically converts to postgresql://...
DATABASE_URL=postgresql://attendai_user:password@dpg-xxxx-a.oregon-postgres.render.com/attendai_db

# Allowed Origins for FastAPI CORS (no wildcard when allow_credentials=True)
CORS_ORIGINS=https://attendai-frontend.vercel.app,http://localhost:3000

# Computer Vision & Recognition Parameters
FACE_MATCH_THRESHOLD=0.70
FACE_REVIEW_THRESHOLD=0.52
MAX_UPLOAD_SIZE_MB=15

# ----------------------------------------------------
# Frontend Deployment (e.g. Vercel)
# ----------------------------------------------------
# Recommended setup with Next.js rewrites proxy (avoids 3rd-party cookie blocking):
# 1. Set BACKEND_URL to your Render web service URL (without /api)
BACKEND_URL=https://attendai-backend.onrender.com

# 2. Set NEXT_PUBLIC_API_URL to /api (or leave blank to use the default proxy)
NEXT_PUBLIC_API_URL=/api

# Direct Cross-Origin alternative (if not using rewrites proxy):
# NEXT_PUBLIC_API_URL=https://attendai-backend.onrender.com/api